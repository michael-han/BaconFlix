{
    "name": "baconflix",
    "version": "1.0.0",
    "description": "A Discord bot for requesting movies on a Plex server via Radarr.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/michael-han/BaconFlix.git"
    },
    "license": "MIT",
    "author": "@michael-han",
    "type": "module",
    "main": "src/index.js",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "node src/index.js",
        "dev": "node --watch src/index.js",
        "deploy-commands": "node src/deploy-commands.js",
        "test": "node --test",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "axios": "^1.20.0",
        "discord.js": "^14.27.0",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0"
    },
    "devDependencies": {
        "prettier": "^3.9.10"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 100,
        "overrides": [
            {
                "files": [
                    "*.yml",
                    "*.yaml",
                    "*.md"
                ],
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    }
}
