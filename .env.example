# Copy this file to .env and fill in the values.
# Only the variables marked "required" must be set; everything else has a default.

# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications → your app → Bot. (required)
DISCORD_TOKEN=
# Application ID from the same page → General Information. (required)
DISCORD_CLIENT_ID=
# Optional: register /request to this one server only. Updates appear instantly,
# whereas global commands can take a while to show up.
DISCORD_GUILD_ID=

# --- Radarr ----------------------------------------------------------------
# Base URL of your Radarr instance, without /api. (required)
RADARR_URL=http://localhost:7878
# Radarr → Settings → General → Security → API Key. (required)
RADARR_API_KEY=
# Quality profile to add movies with. The bot logs the available IDs at startup
# if this doesn't match, or see Radarr → Settings → Profiles. Default: 1
RADARR_QUALITY_PROFILE_ID=1
# Root folder to add movies to; must match one in Radarr → Settings → Media Management.
# Default: /movies
RADARR_ROOT_FOLDER=/movies

# --- Access control ----------------------------------------------------------
# Comma-separated Discord IDs. Leave blank to allow everyone.
# (Enable Developer Mode in Discord, then right-click a server or role → Copy ID.)
ALLOWED_GUILD_IDS=
ALLOWED_ROLE_IDS=

# --- Limits ------------------------------------------------------------------
# Searches allowed per user per window. 0 disables rate limiting. Default: 3
RATE_LIMIT_MAX=3
# Default: 10
RATE_LIMIT_WINDOW_MINUTES=10
# Refuse new requests when the root folder has less free space than this. 0 disables.
# Default: 1024 (1 TB)
DISK_SPACE_MIN_GB=1024

# --- Networking & logging ----------------------------------------------------
# Timeout for calls to Radarr. Default: 15000
HTTP_TIMEOUT_MS=15000
# Skip TLS certificate checks for an https RADARR_URL with a self-signed cert. Default: false
INSECURE_TLS=false
# fatal, error, warn, info, debug, trace, or silent. Default: info
LOG_LEVEL=info
